(
    schema_version: 1,
    id: "builtin.brush.paint.directional_flat",
    display_name: "Directional Flat",

    engine_id: "paint",

    stroke: (
        strategy: SpacingDab(spacing: 0.08),
        input_filter: (stabilization: 2, pressure_filter: 3),
        pressure_response: (feel: 100.0),
        size_scene_ratio: (
            value: 0.01,
            range: (0.001, 0.2),
        ),
        size_pressure: (
            enabled: true,
            curve: [
                (x: 0.0, y: 0.0),
                (x: 1.0, y: 1.0),
            ],
        ),
    ),

    engine_params: {
        "composite_mode": "source_over",
        "opacity": 1.0,
        "flow": 0.8,
        "flow_pressure": (
            enabled: true,
            curve: [
                (x: 0.0, y: 0.0),
                (x: 1.0, y: 1.0),
            ],
        ),
        "shape": "texture_mask",
        "tip_mask": Resource("texture.brush_tip.dotted_flat"),
        "tip_rotation": "stroke_direction",
        "anti_aliasing": true,
    },

    quick_params: [
        Common(Size),
        Common(Spacing),
        Common(Stabilization),
        Engine("opacity"),
        Engine("flow"),
        Engine("anti_aliasing"),
    ],

    tags: ["paint", "directional", "texture_mask"],
)
