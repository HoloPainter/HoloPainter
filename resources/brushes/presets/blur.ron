(
    schema_version: 1,
    id: "builtin.brush.filter.blur",
    display_name: "Blur",

    engine_id: "blur",

    stroke: (
        strategy: SpacingDab(spacing: 0.3),
        input_filter: (stabilization: 0, pressure_filter: 0),
        pressure_response: (feel: 100.0),
        size_scene_ratio: (
            value: 0.01,
            range: (0.001, 0.2),
        ),
        size_pressure: (
            enabled: true,
            curve: [
                    (x: 0.0, y: 0.0),
                    (x: 1.0, y: 1.0),
                ],
        ),
    ),

    engine_params: {
        "opacity": 1.0,
        "strength": 1.0,
        "strength_pressure": (
            enabled: false,
            curve: [
                    (x: 0.0, y: 0.0),
                    (x: 1.0, y: 1.0),
                ],
        ),
        "blur_radius_ratio": 1.0,
        "hardness": 0.001,
    },

    quick_params: [
        Common(Size),
        Engine("opacity"),
        Engine("strength"),
        Engine("blur_radius_ratio"),
    ],

    tags: ["filter", "blur"],
)
